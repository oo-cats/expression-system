{
  "name": "local/expression-system",
  "description": "Auditable expressions, kaomoji, favorites and typography for the private media library",
  "version": "0.1.0",
  "type": "flarum-extension",
  "license": "MIT",
  "require": {"php": "^8.3", "flarum/core": "^1.8", "local/media-library": "^0.2"},
  "require-dev": {"flarum/testing": "^1.0", "flarum/core": "1.8.19", "flarum/markdown": "1.8.1", "flarum/emoji": "1.8.1"},
  "repositories": [{"type":"path","url":"../media-library","options":{"symlink":true}}],
  "autoload": {"psr-4": {"Local\\ExpressionSystem\\": "src/"}},
  "autoload-dev": {"psr-4": {"Local\\ExpressionSystem\\Tests\\": "tests/"}},
  "extra": {"flarum-extension": {"title": "expression-system", "icon": {"name": "fas fa-puzzle-piece", "backgroundColor": "#456", "color": "#fff"}}},
  "scripts": {
    "test": ["@test:unit", "@test:integration"],
    "test:unit": "phpunit -c tests/phpunit.unit.xml",
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php"
  },
  "config": {
    "sort-packages": true,
    "policy": {"advisories": {"ignore-id": {
      "PKSA-w9tt-7782-78jx": {"on-audit": false, "reason": "Local Flarum 1.8.19 compatibility tests require Flysystem 1.x. Audit remains enabled; not a production security fix."}
    }}}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
